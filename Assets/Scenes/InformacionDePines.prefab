    - target: {fileID: 1324653313682529973, guid: d0f5d921837d4d74ab139feae0f837f5,
        type: 3}
      propertyPath: m_text
      value: "Ubicaci\xF3n:\nUne el h\xEDgado a la pared abdominal anterior y al
        diafragma.\n\nFunci\xF3n:\nDivide anat\xF3micamente el l\xF3bulo derecho
        e izquierdo.\nContiene el ligamento redondo (vena umbilical obliterada).\n\nIrrigaci\xF3n:\nPeque\xF1as
        ramas hep\xE1ticas y epig\xE1stricas.\n\nImportancia Cl\xEDnica:\nReferencia
        quir\xFArgica hep\xE1tica.\nImportante en hipertensi\xF3n portal (recanalizaci\xF3n
        umbilical)."
      objectReference: {fileID: 0}
