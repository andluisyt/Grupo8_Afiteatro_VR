      propertyPath: m_text
      value: "Ubicaci\xF3n:\nDentro de la cavidad craneal, porci\xF3n superior del
        enc\xE9falo.\n\nFunci\xF3n:\nFunciones cognitivas superiores, control motor
        voluntario, integraci\xF3n sensitiva, lenguaje y memoria.\n\nIrrigaci\xF3n:\nSistema
        carot\xEDdeo interno y sistema vertebrobasilar (Pol\xEDgono de Willis).\n\nImportancia
        Cl\xEDnica:\nACV isqu\xE9mico o hemorr\xE1gico.\nTumores cerebrales.\nEpilepsia."
      objectReference: {fileID: 0}
