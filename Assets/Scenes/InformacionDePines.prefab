      propertyPath: m_text
      value: "Ubicaci\xF3n:\nMitad derecha del cerebro, separada por la fisura longitudinal.\n\nFunci\xF3n:\nProcesamiento
        espacial, reconocimiento facial, creatividad, control motor del lado izquierdo
        del cuerpo.\n\nIrrigaci\xF3n:\nArterias cerebral anterior, media y posterior
        derechas.\n\nImportancia Cl\xEDnica:\nHemiparesia izquierda.\nHeminegligencia
        espacial (lesi\xF3n parietal derecha)."
      objectReference: {fileID: 0}
